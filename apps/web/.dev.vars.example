# Copy to .dev.vars for local development. Never commit real keys.
# Production values are set with `npx wrangler secret put <NAME>`.

# Signs sessions. Any long random string; generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# One-time code needed to create the library on first run. Required in production.
SETUP_CODE=

# Email providers. With neither set, emails (including sign-in codes) are
# printed in the terminal instead of sent.
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
