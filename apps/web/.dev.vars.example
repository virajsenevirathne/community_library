# Copy to .dev.vars for local development. Never commit real keys.
# Production values are set with `npx wrangler secret put <NAME>`.

# Signs sessions. Any long random string; generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# One-time code needed to create the library on first run. Required in production.
SETUP_CODE=

# Optional: a free Google Books API key, so books Open Library doesn't know
# (many recent Australian editions) are still found. Without one, Google's
# shared anonymous quota is usually used up and those lookups fail.
# Create one at https://console.cloud.google.com/apis/credentials with the
# "Books API" enabled; restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=

# Email providers. With neither set, emails (including sign-in codes) are
# printed in the terminal instead of sent.
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Leave empty for local development, so links and passkeys use the address
# you open (localhost). The live address is set in wrangler.jsonc.
APP_URL=
