{
  "name": "@community-library/web",
  "version": "0.0.0",
  "private": true,
  "description": "The Community Library app: one Cloudflare Worker serving the API (Hono) and the web app (React).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "vapid-keys": "node scripts/vapid-keys.mjs",
    "icons": "node scripts/make-icons.mjs",
    "docs-screenshots": "DOCS_SCREENSHOTS=1 playwright test -c e2e/playwright.config.ts e2e/screenshots.spec.ts",
    "demo-data": "wrangler d1 execute DB --local --file scripts/demo-data.sql"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.20",
    "@community-library/adapters": "*",
    "@community-library/core": "*",
    "@simplewebauthn/browser": "^13.3.0",
    "barcode-detector": "^3.2.3",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
