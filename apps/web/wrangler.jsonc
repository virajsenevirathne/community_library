{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "community-library",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The React app is served as static assets. Only /api/* runs the Worker first;
  // every other path falls back to index.html so client-side routes work.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-library",
      // Replace with the id printed by `npx wrangler d1 create community-library`.
      // Local development does not need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],

  // Daily reminder job. Cron runs in UTC: 20:00 UTC is 07:00 in Sydney during
  // daylight saving. Per-library local times are handled in VIR-23.
  "triggers": {
    "crons": ["0 20 * * *"]
  },

  "vars": {
    // Shown before the library is set up, and used as the passkey name.
    "LIBRARY_NAME": "Community Library",
    // Sender for all email. Must be on a domain verified with Resend and Mailjet.
    "EMAIL_FROM": "library@example.com",
    // The site's public address, such as https://library.example.org. Set it in
    // production: passkeys only work on the address they were saved on. Empty
    // means "whatever address the request used", which suits local development.
    "APP_URL": ""
  }
}
