{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "community-library",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The free *.workers.dev address stays on (handy before a domain is attached).
  // Per-version preview URLs stay off: they would all share the live database.
  "workers_dev": true,
  "preview_urls": false,

  // The React app is served as static assets. Only /api/* runs the Worker first;
  // every other path falls back to index.html so client-side routes work.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-library",
      // From `npx wrangler d1 create community-library`. Anyone reusing this
      // project creates their own database and puts its id here.
      "database_id": "deba61e5-3d47-43d9-bb2f-e6b9a9a790f0",
      "migrations_dir": "../../migrations"
    }
  ],

  // Hourly job: each library's reminders go out once a day at its own local
  // reminder hour (Settings), plus the Monday staff digest and privacy tidy-up.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    // Shown before the library is set up, and used as the passkey name.
    "LIBRARY_NAME": "Community Library",
    // Sender for all email. Must be on a domain verified with Resend and Mailjet.
    "EMAIL_FROM": "library@example.com",
    // The site's public address, such as https://library.example.org. Set it in
    // production: passkeys only work on the address they were saved on. Empty
    // means "whatever address the request used", which suits local development.
    "APP_URL": ""
  }
}
